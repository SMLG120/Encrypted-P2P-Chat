# Production build defaults.
#
# These are placeholders for a split deployment (e.g. frontend on Vercel,
# backend on Render) where frontend and backend are on different origins.
# Override the real values as project environment variables in your hosting
# dashboard (e.g. Vercel → Project → Settings → Environment Variables) —
# those take precedence over this file at build time and keep the actual
# domain out of git history.
#
# If you instead deploy the full Docker Compose stack (nginx in front of
# both frontend and backend on one origin), leave these EMPTY so the
# frontend falls back to same-origin requests — see frontend/Dockerfile,
# which already builds with empty VITE_API_URL/VITE_WS_URL for that path.
VITE_API_URL=https://REPLACE_WITH_YOUR_BACKEND_DOMAIN
VITE_WS_URL=wss://REPLACE_WITH_YOUR_BACKEND_DOMAIN/ws
VITE_FRONTEND_ORIGIN=https://REPLACE_WITH_YOUR_FRONTEND_DOMAIN

# ════════════════════════════════════════════════════════════════════════════
# Encrypted P2P Chat — Environment Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production          # development | staging | production
DEBUG=false
API_BACKEND_URL=http://localhost:8000

# ── CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ── WebAuthn (MUST match the domain users visit) ──────────────────────────────
# Docker/nginx quick start: http://localhost
# Vite local dev frontend: http://localhost:5173
# For production: your actual domain, e.g. chat.example.com
RP_ID=localhost
WEBAUTHN_RP_NAME=Crypt
RP_ORIGIN=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ── Vite dev server proxy ─────────────────────────────────────────────────────
# Defaults to the FastAPI backend directly on the host.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# ── Cookie Security ────────────────────────────────────────────────────────────
# Set to true in production with HTTPS
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ── Attachment storage ─────────────────────────────────────────────────────────
# "local" (default) writes to ATTACHMENT_STORAGE_DIR — fine for the Docker
# Compose stack, which backs it with a named volume. Use "s3" instead on any
# platform without a persistent/shared disk (e.g. a typical Render backend
# deploy) — works with AWS S3, Cloudflare R2, Supabase Storage, or MinIO by
# pointing S3_ENDPOINT_URL at the relevant gateway.
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_STORAGE_DIR=uploads/attachments
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

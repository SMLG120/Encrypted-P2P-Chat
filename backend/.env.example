# Copy to backend/.env for running the backend natively (not in Docker):
#   cp backend/.env.example backend/.env
#
# docker-compose.dev.yml maps Postgres/Redis to non-default host ports to
# avoid clashing with a Postgres/Redis you might already have running
# locally on 5432/6379 — so a natively-run backend must point at those
# non-default ports explicitly. Without this file, Settings() falls back to
# localhost:5432 / localhost:6379, which silently hits the wrong service
# (or nothing) once docker-compose.dev.yml's postgres/redis containers are
# the ones actually running.
DATABASE_URL=postgresql+asyncpg://chat:chatpass@localhost:5433/chatdb
REDIS_URL=redis://localhost:6380/0

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-not-for-production-use
RP_ID=localhost
RP_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
